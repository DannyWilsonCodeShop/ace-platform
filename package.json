{
  "name": "ace-platform",
  "private": true,
  "workspaces": [
    "packages/*",
    "api"
  ],
  "scripts": {
    "admin:dev": "npm run dev --workspace=packages/admin",
    "portal:dev": "npm run dev --workspace=packages/portal",
    "admin:build": "npm run build --workspace=packages/admin",
    "portal:build": "npm run build --workspace=packages/portal",
    "api:deploy": "cd api && npm run deploy"
  },
  "devDependencies": {
    "typescript": "^5.5.0"
  }
}
